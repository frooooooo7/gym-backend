# Copy to .env for local development (`npm run dev`). docker-compose.yml reads
# the same variables for its defaults.

# development | production (production enables strict validation, JSON logs,
# CORS whitelist, HSTS and `trust proxy`)
NODE_ENV=development
PORT=3000

# PostgreSQL — local database: docker compose up -d postgres
# Required when NODE_ENV=production (the API refuses to start without it).
# In development it may be empty: the API starts and /ready returns 503.
DATABASE_URL=postgresql://gym:gym@localhost:5432/gym
# Max connections in the pg pool (default 10)
# PG_POOL_MAX=10

# PostgreSQL password (also used by docker-compose)
POSTGRES_PASSWORD=gym
# Host ports published by docker-compose (defaults 5432 / 3000)
# POSTGRES_PORT=5432
# API_PORT=3000

# JWT — required in production; use a random string of at least 32 characters
# Example: openssl rand -base64 48
JWT_SECRET=change-me-before-going-to-production-min-32!!

# CORS — used when NODE_ENV=production: comma-separated whitelist of browser origins.
# Empty in production only logs a warning at startup (native mobile apps don't use
# CORS), but browsers such as Flutter web will be blocked.
# CORS_ORIGIN=http://localhost:65425,http://127.0.0.1:65425
# Production: CORS_ORIGIN=https://app.example.com

# Logging — debug | info | warn | error | silent (default info; tests are silent).
# Format: JSON lines when NODE_ENV=production, compact text otherwise.
# LOG_LEVEL=info
