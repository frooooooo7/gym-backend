NODE_ENV=development
PORT=3000

# PostgreSQL — uruchom lokalna baze: docker compose up -d postgres
DATABASE_URL=postgresql://gym:gym@localhost:5432/gym

# Haslo do PostgreSQL (uzywane tez w docker-compose)
POSTGRES_PASSWORD=gym

# JWT — zmien na losowy ciag min. 32 znakow przed wdrozeniem
# Przyklad: openssl rand -base64 48
JWT_SECRET=change-me-before-going-to-production-min-32!!

# CORS — gdy NODE_ENV=production: biala lista zrodel (przecinkami). Przyklad Flutter web / Docker API:
# CORS_ORIGIN=http://localhost:65425,http://127.0.0.1:65425
# Produkcja: CORS_ORIGIN=https://app.example.com
